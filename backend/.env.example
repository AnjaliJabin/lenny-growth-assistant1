# LLM Provider: "anthropic" or "ollama"
LLM_PROVIDER=ollama

# Anthropic (cloud)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lenny_assistant

# App
SECRET_KEY=change_me_to_a_random_secret_key_32chars
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Embeddings model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector index path
VECTOR_INDEX_PATH=./data/vector_index

# Transcripts path
TRANSCRIPTS_PATH=./data/transcripts
